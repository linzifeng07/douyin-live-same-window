{
  "manifest_version": 3,
  "name": "抖音直播同窗口打开",
  "version": "2.1.6",
  "description": "从抖音网页进入直播时，在当前窗口内显示直播间，避开跨域应用提示栏。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://douyin.com/*",
        "https://www.douyin.com/*"
      ],
      "js": [
        "media-sync.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://douyin.com/*",
        "https://www.douyin.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://live.douyin.com/*"
      ],
      "js": [
        "media-sync.js",
        "live-pip.js",
        "live-frame-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://live.douyin.com/*"
      ],
      "js": [
        "live-frame-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
